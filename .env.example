# =============================================================================
# VARIABLES DE ENTORNO Y CONFIGURACIÓN DE APIS - CODEX PLATAFORMA EDUCATIVA
# =============================================================================
# Copia este contenido a tu archivo .env real y añade tus claves secretas.

# -----------------------------------------------------------------------------
# 1. SUPABASE (Base de datos PostgreSQL, Autenticación y Storage)
# Obtén estas credenciales en: https://supabase.com -> Tu Proyecto -> Project Settings -> API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key-aqui

# -----------------------------------------------------------------------------
# 2. PASARELAS DE PAGO ($5.00 USD por Curso)
# -----------------------------------------------------------------------------

# --- A) STRIPE ---
# Panel de Stripe: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica_stripe_aqui
STRIPE_SECRET_KEY=sk_test_tu_clave_privada_stripe_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# --- B) PAYPAL SMART CHECKOUT ---
# Developer Portal: https://developer.paypal.com/dashboard/applications
VITE_PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui
VITE_PAYPAL_CURRENCY=USD

# --- C) PADDLE BILLING ---
# Dashboard de Paddle: https://vendors.paddle.com/authentication
VITE_PADDLE_VENDOR_ID=tu_paddle_vendor_id_numerico_aqui
PADDLE_API_KEY=tu_paddle_api_key_aqui
PADDLE_PUBLIC_KEY=tu_paddle_public_key_aqui

# -----------------------------------------------------------------------------
# 3. GEMINI AI (Generación de código, tutor inteligente y explicaciones)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=MY_GEMINI_API_KEY

# -----------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL SERVIDOR Y APLICACIÓN
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
